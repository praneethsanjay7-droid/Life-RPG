<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All the tasks</title>
</head>
<body>
    
    <h1>All the tasks</h1>
<div>
        Total tasks: <%=total%> | Completed: <%=completed%> | Remaining: <%=remaining%>
    </div>
    <form action="/newTask" method="get">
        <button>New Task</button>
    </form>
    <form action="/stats" method="get">
        <button>Stats</button>
    </form>
    <hr>
    <% for(task of tasks){%>
        <h1><%=task.title%></h1>
        <form action="/taskDetails/<%=task._id%>" method="get">
            <button>Get details</button>
        </form>
        <form action="/editTask/<%=task._id%>" method="get">
            <button>Edit task</button>
        </form>
        <form action="/deleteTask/<%=task._id%>" method="post">
            <button>Delete Task</button>
        </form>
        <br>
        <hr>
    <%}%>
</body>
</html>
