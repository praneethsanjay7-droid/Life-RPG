<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task</title>
</head>
<body>
  <h1><%=taskDetails.title%></h1>
  <a href="/allTasks">Back to all tasks</a>
  <form action="/editTask/<%=taskDetails._id%>" method="post">
    <label for="title">Title:</label>
    <br>
    <input type="text" id="title" name="title" value="<%=taskDetails.title%>" required>
    <br>
    <label for="startTime">Start time:</label>
    <br>
    <input type="datetime-local" id="startTime" name="startTime" value="<%=taskDetails.startTime.toISOString().slice(0,16)%>" required>
    <br>
    <label for="endTime">End time:</label>
    <br>
    <input type="datetime-local" id="endTime" name="endTime" value="<%=taskDetails.endTime.toISOString().slice(0,16)%>" required>
    <br>
    <label for="completed">Completed:</label>
    <input type="checkbox" id="completed" name="completed" value="true" <%=taskDetails.completed ? 'checked' : ''%>>
    <br>
    <button type="submit">Edit Task</button>
  </form>
</body>
</html>
