<%- layout('layouts/boilerplate') %>

<header class="dc-header">
  <a href="/allTasks" class="dc-header-brand">🐉 DRAGON'S CONQUEST</a>
  <div class="dc-header-stats">
    <div class="dc-stat-badge">🐉 Dragon Level: <span><%= user.dragonLevel || 1 %></span></div>
    <div class="dc-stat-badge">⚔️ Streak: <span><%= user.conquestStreak || 0 %></span></div>
  </div>
  <nav class="dc-header-nav">
    <a href="/allTasks" class="dc-btn dc-btn-ghost">← Back to Realm</a>
  </nav>
</header>

<div class="dc-stats-layout">
  <h1 class="dc-stats-title">📜 CONQUEST CHRONICLES</h1>
  <p class="dc-stats-subtitle">The annals of your dragon's conquest</p>

  <!-- Period Tabs -->
  <div class="dc-period-tabs">
    <button class="dc-period-tab active" id="tab-daily" onclick="switchTab('daily')">DAILY</button>
    <button class="dc-period-tab" id="tab-weekly" onclick="switchTab('weekly')">WEEKLY</button>
    <button class="dc-period-tab" id="tab-monthly" onclick="switchTab('monthly')">MONTHLY</button>
  </div>

  <!-- Stats Cards -->
  <div class="dc-stats-grid">
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">🔥</div>
      <div class="dc-stats-card-value" id="stat-conquered"><%= dailyCompleted %></div>
      <div class="dc-stats-card-label">CONQUERED</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">🏰</div>
      <div class="dc-stats-card-value" id="stat-remaining"><%= dailyRemaining %></div>
      <div class="dc-stats-card-label">STILL STANDING</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">⚔️</div>
      <div class="dc-stats-card-value"><%= totalConquered %></div>
      <div class="dc-stats-card-label">ALL TIME CONQUERED</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">🐉</div>
      <div class="dc-stats-card-value"><%= user.dragonLevel || 1 %></div>
      <div class="dc-stats-card-label">DRAGON LEVEL</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">⭐</div>
      <div class="dc-stats-card-value"><%= user.currentXP || 0 %></div>
      <div class="dc-stats-card-label">CURRENT XP</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">⚔️</div>
      <div class="dc-stats-card-value"><%= user.conquestStreak || 0 %></div>
      <div class="dc-stats-card-label">STREAK</div>
    </div>
  </div>

  <!-- Character Stats -->
  <div class="dc-stats-grid">
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">🧠</div>
      <div class="dc-stats-card-value"><%= user.intellect || 0 %></div>
      <div class="dc-stats-card-label">INTELLIGENCE</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">💪</div>
      <div class="dc-stats-card-value"><%= user.strength || 0 %></div>
      <div class="dc-stats-card-label">STRENGTH</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">⚡</div>
      <div class="dc-stats-card-value"><%= user.agility || 0 %></div>
      <div class="dc-stats-card-label">AGILITY</div>
    </div>
    <div class="dc-stats-card">
      <div class="dc-stats-card-icon">💎</div>
      <div class="dc-stats-card-value"><%= user.charisma || 0 %></div>
      <div class="dc-stats-card-label">CHARISMA</div>
    </div>
  </div>

  <!-- Chart -->
  <div class="dc-chart-container">
    <div class="dc-chart-title" id="chartTitle">⚔️ DAILY CONQUEST REPORT</div>
    <canvas id="progressChart" height="120"></canvas>
  </div>

  <!-- Conquered Chronicle List -->
  <div class="dc-conquered-chronicle">
    <div class="dc-chronicle-title">🏚️ FALLEN KINGDOMS</div>
    <% if (conqueredTasks && conqueredTasks.length > 0) { %>
      <% conqueredTasks.slice(0,10).forEach(task => { %>
        <div class="dc-chronicle-item">
          <span class="dc-chronicle-icon">🏚️</span>
          <span class="dc-chronicle-name"><%= task.title %></span>
          <% if (task.completedAt) { %>
            <span class="dc-chronicle-date"><%= task.completedAt.toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'}) %></span>
          <% } %>
          <span class="dc-chronicle-check">✓</span>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align:center;padding:1.5rem;color:#2d2828;font-style:italic;">
        No kingdoms conquered yet. The realm stands defiant.
      </div>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const dailyLabels    = <%= JSON.stringify(dailyChartLabels) %>;
const dailyCompleted = <%= JSON.stringify(dailyChartCompleted) %>;
const dailyRemaining = <%= JSON.stringify(dailyChartRemaining) %>;
const weeklyLabels    = <%= JSON.stringify(weeklyChartLabels) %>;
const weeklyCompleted = <%= JSON.stringify(weeklyChartCompleted) %>;
const weeklyRemaining = <%= JSON.stringify(weeklyChartRemaining) %>;
const monthlyLabels    = <%= JSON.stringify(monthlyChartLabels) %>;
const monthlyCompleted = <%= JSON.stringify(monthlyChartCompleted) %>;
const monthlyRemaining = <%= JSON.stringify(monthlyChartRemaining) %>;

const datasets = {
  daily: {
    labels: dailyLabels,
    conquered: dailyCompleted,
    remaining: dailyRemaining,
    title: '⚔️ DAILY CONQUEST REPORT'
  },
  weekly: {
    labels: weeklyLabels,
    conquered: weeklyCompleted,
    remaining: weeklyRemaining,
    title: '⚔️ WEEKLY CONQUEST REPORT'
  },
  monthly: {
    labels: monthlyLabels,
    conquered: monthlyCompleted,
    remaining: monthlyRemaining,
    title: '⚔️ MONTHLY CONQUEST REPORT'
  }
};

const ctx = document.getElementById('progressChart').getContext('2d');
const chart = new Chart(ctx, {
  type: 'bar',
  data: {
    labels: datasets.daily.labels,
    datasets: [
      {
        label: 'Conquered',
        data: datasets.daily.conquered,
        backgroundColor: 'rgba(74, 140, 42, 0.75)',
        borderColor: 'rgba(74, 140, 42, 1)',
        borderWidth: 1,
        stack: 'stack1'
      },
      {
        label: 'Standing',
        data: datasets.daily.remaining,
        backgroundColor: 'rgba(139, 26, 26, 0.65)',
        borderColor: 'rgba(192, 57, 43, 1)',
        borderWidth: 1,
        stack: 'stack1'
      }
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { labels: { color: '#c9a86c', font: { family: 'Cinzel, serif', size: 11 } } }
    },
    scales: {
      x: {
        stacked: true,
        ticks: { color: '#8b6914' },
        grid:  { color: 'rgba(60,50,40,0.4)' }
      },
      y: {
        stacked: true,
        beginAtZero: true,
        ticks: { color: '#8b6914', stepSize: 1 },
        grid:  { color: 'rgba(60,50,40,0.4)' }
      }
    }
  }
});

function switchTab(period) {
  document.querySelectorAll('.dc-period-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + period).classList.add('active');

  const d = datasets[period];
  document.getElementById('chartTitle').textContent = d.title;
  chart.data.labels = d.labels;
  chart.data.datasets[0].data = d.conquered;
  chart.data.datasets[1].data = d.remaining;
  chart.update();

  // Update stats cards
  if (period === 'daily') {
    document.getElementById('stat-conquered').textContent = '<%= dailyCompleted %>';
    document.getElementById('stat-remaining').textContent = '<%= dailyRemaining %>';
  } else if (period === 'weekly') {
    const wc = d.conquered.reduce((a,b) => a+b, 0);
    const wr = d.remaining.reduce((a,b) => a+b, 0);
    document.getElementById('stat-conquered').textContent = wc;
    document.getElementById('stat-remaining').textContent = wr;
  } else if (period === 'monthly') {
    const mc = d.conquered.reduce((a,b) => a+b, 0);
    const mr = d.remaining.reduce((a,b) => a+b, 0);
    document.getElementById('stat-conquered').textContent = mc;
    document.getElementById('stat-remaining').textContent = mr;
  }
}
</script>
