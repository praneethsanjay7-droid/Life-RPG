# Dragon's Conquest — Environment Variables
# Copy this file to .env and fill in your values

# Session secret (use a long random string in production)
SESSION_SECRET=dragons-conquest-change-this-secret

# MongoDB connection string
# For local development:
MONGODB_URI=mongodb://127.0.0.1:27017/lifePRG
# For Vercel deployment, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifePRG?retryWrites=true&w=majority

# Port (optional, defaults to 9090)
PORT=9090